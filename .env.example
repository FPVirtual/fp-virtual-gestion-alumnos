# ==========================================
# Entorno
# ==========================================
ENVIRONMENT=dev
SUBDOMAIN=test

# ==========================================
# Driver de Moodle
# ==========================================
# Opciones: moosh | api
MOODLE_DRIVER=moosh

# ==========================================
# API SIGAD
# ==========================================
API_BASE_URL=https://aplicaciones.aragon.es/pcrpe/services/alumnosFPDistancia
API_USER=tu_usuario
API_PASSWORD=tu_password
API_TIMEOUT=30
API_MAX_RETRIES=5
API_RETRY_DELAY=10

# ==========================================
# Moosh (solo si MOODLE_DRIVER=moosh)
# ==========================================
MOOSH_PATH=moosh
# Si moosh está dentro de un contenedor Docker, indica su nombre:
# DOCKER_CONTAINER=moodle_app
DOCKER_CONTAINER=
MOOSH_TIMEOUT=60

# ==========================================
# API REST Moodle (solo si MOODLE_DRIVER=api)
# ==========================================
# MOODLE_API_URL=https://tu-moodle.es/webservice/rest/server.php
# MOODLE_API_TOKEN=tu_token_ws

# ==========================================
# Email SMTP
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_USE_TLS=true

# ==========================================
# Reportes
# ==========================================
REPORT_TO="admin@fpvirtualaragon.es"

# ==========================================
# Rutas
# ==========================================
BASE_PATH=/var/fp-distancia-gestion-usuarios-automatica/
